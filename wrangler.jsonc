{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "choir-assistant-auth-staging",
  "main": "./src/worker.ts",
  "compatibility_date": "2026-10-11",
  "workers_dev": false,
  "preview_urls": false,
  "routes": [
    {
      "pattern": "staging.epistrophe.it",
      "custom_domain": true
    }
  ],
  "vars": {
    "APP_ORIGIN": "https://staging.epistrophe.it",
    "CLERK_FRONTEND_API_ORIGIN": "https://clerk.staging.epistrophe.it",
    "CLERK_PUBLISHABLE_KEY": "pk_live_Y2xlcmsuc3RhZ2luZy5lcGlzdHJvcGhlLml0JA=="
  },
  "d1_databases": [
    {
      "binding": "AUTH_DB",
      "database_name": "choir-assistant-auth-staging",
      "database_id": "e3a39346-1c15-4cf1-8223-449a6ef98fad",
      "migrations_dir": "migrations"
    }
  ],
  "r2_buckets": [
    {
      "binding": "PERFORMANCE_BUCKET",
      "bucket_name": "choir-assistant-performances-staging"
    }
  ],
  "triggers": {
    "crons": ["17 3 * * *"]
  },
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "run_worker_first": true,
    "not_found_handling": "none"
  }
}
